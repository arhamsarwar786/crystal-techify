# Local: Docker Postgres (pnpm db:up) on 5433
# Vercel: Settings → Environment Variables → DATABASE_URL (any Postgres URL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/crystal_techify"

AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@crystaltechify.com"
ADMIN_PASSWORD="changeme"

# Optional. When set, CVs go to Vercel Blob instead of data/uploads.
# BLOB_READ_WRITE_TOKEN=""
