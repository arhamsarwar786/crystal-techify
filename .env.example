# Copy to `.env.local` and fill in.

# Web3Forms access key for the homepage contact form.
# Get a free key at https://web3forms.com (enter the address that should
# receive submissions — info@crystaltechify.com).
# While this is empty the form still works: it opens the visitor's mail
# client with a pre-filled, copyable message instead of posting directly.
NEXT_PUBLIC_WEB3FORMS_KEY=
