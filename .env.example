# Local only (pnpm db:up). Do NOT paste this into Vercel — 127.0.0.1 is your laptop.
# Vercel → Settings → Environment Variables → DATABASE_URL = a public Postgres URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/crystal_techify"

AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@crystaltechify.com"
ADMIN_PASSWORD="changeme"

# Optional. When set, CVs go to Vercel Blob instead of data/uploads.
# BLOB_READ_WRITE_TOKEN=""
