# Local Docker Postgres (pnpm db:up). Host 5433 avoids a local Postgres on 5432.
# On Vercel Storage → Neon these two names are injected automatically.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/crystal_techify"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:5433/crystal_techify"

AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@crystaltechify.com"
ADMIN_PASSWORD="changeme"

# Optional. When set, CVs go to Vercel Blob instead of data/uploads.
# Create a Blob store in the Vercel dashboard and paste the token.
# BLOB_READ_WRITE_TOKEN=""
